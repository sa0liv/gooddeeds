# Configurações do servidor
PORT=3001

# URL do frontend (necessário em produção para o CORS)
# Exemplo: https://gooddeeds.vercel.app
FRONTEND_URL=http://localhost:5173

# Banco de dados — opção 1: connection string (Render/Supabase)
# DATABASE_URL=postgresql://usuario:senha@host:5432/gooddeeds

# Banco de dados — opção 2: variáveis individuais (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=gooddeeds

# Chave secreta para geração de tokens JWT
# Use uma string longa e aleatória em produção
JWT_SECRET=troque_por_uma_chave_secreta_longa
